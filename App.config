<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=.\SQLEXPRESS;Database=ProcessTestDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Keep LAN access disabled by default. Set to true only on a trusted private network. -->
    <add key="EnableLanMode" value="false" />
  </appSettings>
</configuration>
